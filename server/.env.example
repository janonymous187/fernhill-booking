# Copy to server/.env (gitignored) and fill in. Do not commit real values.
# Test key (rk_test_… or sk_test_…) or, later, a live key (rk_live_… or sk_live_…).
STRIPE_SECRET_KEY=rk_test_...
# Set by `npm run setup-webhook -- https://your-public-url`, or paste from the Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...
PUBLIC_URL=https://your-public-url
PORT=8787
# Password for the groomer bookings page. The dashboard stays closed until this is set.
DASHBOARD_PASSWORD=
# Optional directory for db.json. Defaults to server/data.
DATA_DIR=
